# Copy to .env and edit. Never commit .env.

# REQUIRED. Encrypts the SMTP password stored in the database.
# Generate with: openssl rand -base64 32
# If you lose or change it, the stored SMTP password can no longer be read (enter it again in Settings).
APP_ENCRYPTION_KEY=

# First admin account, created only when the database has no users yet.
# Minimum 10 characters. Remove ADMIN_PASSWORD from the environment afterwards.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Host port that maps to container port 3000.
HOST_PORT=3000

# Behind a reverse proxy? List the proxy addresses or CIDR ranges that may set X-Forwarded-* headers,
# comma separated (for example 172.18.0.0/16), or a hop count such as 1. Empty = trust nobody.
TRUSTED_PROXIES=

# Session cookie "Secure" flag: auto (follows the connection as seen through trusted proxies), true or false.
COOKIE_SECURE=auto

DEFAULT_TIMEZONE=Europe/Amsterdam
# nl or en
DEFAULT_LANGUAGE=nl
